generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  password        String
  role            Role
  name            String
  createdAt       DateTime        @default(now())
  bookings        Booking[]
  events          Event[]
  heldSeats       ShowSeat[]
  venues          Venue[]
  waitlistEntries WaitlistEntry[]
}

model Venue {
  id             String         @id @default(uuid())
  name           String
  address        String
  ownerId        String
  seats          Seat[]
  seatCategories SeatCategory[]
  shows          Show[]
  owner          User           @relation(fields: [ownerId], references: [id])
}

model SeatCategory {
  id              String              @id @default(uuid())
  venueId         String
  name            String
  seats           Seat[]
  venue           Venue               @relation(fields: [venueId], references: [id])
  prices          ShowCategoryPrice[]
  waitlistEntries WaitlistEntry[]
}

model Seat {
  id         String       @id @default(uuid())
  venueId    String
  categoryId String
  row        String
  number     Int
  label      String
  category   SeatCategory @relation(fields: [categoryId], references: [id])
  venue      Venue        @relation(fields: [venueId], references: [id])
  showSeats  ShowSeat[]

  @@unique([venueId, row, number])
}

model Event {
  id          String  @id @default(uuid())
  organiserId String
  title       String
  type        String
  description String?
  organiser   User    @relation(fields: [organiserId], references: [id])
  shows       Show[]
}

model Show {
  id        String              @id @default(uuid())
  eventId   String
  venueId   String
  startsAt  DateTime
  event     Event               @relation(fields: [eventId], references: [id])
  venue     Venue               @relation(fields: [venueId], references: [id])
  prices    ShowCategoryPrice[]
  showSeats ShowSeat[]
  waitlist  WaitlistEntry[]
}

model ShowCategoryPrice {
  id         String       @id @default(uuid())
  showId     String
  categoryId String
  price      Decimal      @db.Decimal(10, 2)
  category   SeatCategory @relation(fields: [categoryId], references: [id])
  show       Show         @relation(fields: [showId], references: [id])
}

model ShowSeat {
  id        String     @id @default(uuid())
  showId    String
  seatId    String
  status    SeatStatus @default(AVAILABLE)
  heldBy    String?
  heldUntil DateTime?
  bookingId String?
  version   Int        @default(0)
  booking   Booking?   @relation(fields: [bookingId], references: [id])
  heldUser  User?      @relation(fields: [heldBy], references: [id])
  seat      Seat       @relation(fields: [seatId], references: [id])
  show      Show       @relation(fields: [showId], references: [id])

  @@unique([showId, seatId])
  @@index([showId, status])
}

model Booking {
  id          String        @id @default(uuid())
  bookingRef  String        @unique
  customerId  String
  showId      String
  status      BookingStatus @default(CONFIRMED)
  totalAmount Decimal       @db.Decimal(10, 2)
  qrCodeUrl   String?
  createdAt   DateTime      @default(now())
  customer    User          @relation(fields: [customerId], references: [id])
  seats       ShowSeat[]
}

model WaitlistEntry {
  id             String         @id @default(uuid())
  showId         String
  categoryId     String
  customerId     String
  status         WaitlistStatus @default(WAITING)
  position       Int
  offerExpiresAt DateTime?
  offerToken     String?
  createdAt      DateTime       @default(now())
  category       SeatCategory   @relation(fields: [categoryId], references: [id])
  customer       User           @relation(fields: [customerId], references: [id])
  show           Show           @relation(fields: [showId], references: [id])

  @@index([showId, categoryId, status, position])
}

enum Role {
  CUSTOMER
  ORGANISER
  ADMIN
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum WaitlistStatus {
  WAITING
  OFFERED
  EXPIRED
  CONVERTED
}
